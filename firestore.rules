rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email == 'admin@pragaticonnect.in' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.userType == 'admin'
      );
    }

    // Users: read own or logged in, write own or admin, delete if admin
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();
    }
    // Contractors: anyone logged in can read, owner or admin can write/delete
    match /contractors/{contractorId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (request.auth.uid == contractorId || isAdmin());
      allow delete: if isAdmin();
    }
    // Companies: anyone logged in can read, owner or admin can write/delete
    match /companies/{companyId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (request.auth.uid == companyId || isAdmin());
      allow delete: if isAdmin();
    }
    // Work Postings: anyone logged in can read, company owner or admin can write/delete
    match /workPostings/{postingId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && (request.auth.uid == resource.data.companyUid || isAdmin());
    }
    // Applications: contractor can create, company can read their postings' applications, admin can manage
    match /applications/{applicationId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if isAdmin();
    }
    // Enquiries: sender, receiver, or admin can read/write
    match /enquiries/{enquiryId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if isAdmin();
    }
    // Notifications: recipient can read and update, authenticated users can create, admin can manage
    match /notifications/{notificationId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if request.auth != null;
    }
    // Reviews: anyone logged in can read, authenticated users can create, reviewer or admin can update, admin can delete
    match /reviews/{reviewId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null && (request.auth.uid == resource.data.reviewerUid || isAdmin());
      allow delete: if isAdmin();
    }
    // OTPs: allow generation and verification for passwordless email sign-in
    match /otps/{otpId} {
      allow read, create, update, delete: if true;
    }
  }
}
